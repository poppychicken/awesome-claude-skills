---
import Button from './Button.astro';

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = 'Where could AI change your business?',
  body = 'A 30-minute conversation with both founders about where you are, what you want to change, and whether we are the right fit. No pitch deck.',
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
  <div class="rounded-3xl bg-brand-gradient text-white px-6 py-12 sm:px-12 sm:py-16 text-center">
    <h2 class="text-3xl sm:text-4xl font-semibold max-w-2xl mx-auto">{heading}</h2>
    <p class="mt-4 text-white/90 max-w-xl mx-auto">{body}</p>
    <div class="mt-8">
      <Button href="/book" variant="inverse">Book a call</Button>
    </div>
  </div>
</section>
