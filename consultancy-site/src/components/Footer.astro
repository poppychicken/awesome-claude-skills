---
import { site } from '../config';
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto max-w-6xl px-4 sm:px-6 py-10 flex flex-col sm:flex-row gap-4 justify-between text-sm text-muted"
  >
    <p>© {year} {site.name}</p>
    <div class="flex gap-5">
      <a href={`mailto:${site.email}`} class="hover:text-ink">{site.email}</a>
      <a href="/book" class="hover:text-ink">Book a call</a>
    </div>
  </div>
</footer>
