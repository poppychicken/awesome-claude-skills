---
import { site, sectionHref } from '../config';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="bg-charcoal text-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-[1fr_auto] sm:px-6">
    <div class="space-y-3">
      <Logo inverse />
      <p class="max-w-sm text-sm text-white/80">{site.tagline}.</p>
    </div>
    <nav aria-label="Footer" class="text-sm">
      <ul class="flex flex-wrap gap-x-6 gap-y-3">
        {
          site.nav.map((item) => (
            <li>
              <a href={sectionHref(item.id)} class="text-white/80 hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href={`mailto:${site.email}`} class="text-white/80 hover:text-white">{site.email}</a></li>
      </ul>
    </nav>
    <p class="text-xs text-white/70 sm:col-span-2">© {year} {site.name}</p>
  </div>
</footer>
