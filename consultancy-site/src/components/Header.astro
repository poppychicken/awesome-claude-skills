---
import { Menu, X } from 'lucide-react';
import { site } from '../config';
import Button from './Button.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && href === path;
---

<header class="sticky top-0 z-20 border-b border-line bg-paper">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <Logo />

    <nav aria-label="Main" class="flex items-center gap-2 sm:gap-6 text-sm">
      <ul class="hidden items-center gap-6 sm:flex">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="text-muted transition-colors hover:text-ink aria-[current=page]:text-ink aria-[current=page]:font-medium"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/book" size="sm">Book a call</Button>

      <!-- Phones: a no-JS disclosure keeps every page reachable. -->
      <details class="group relative sm:hidden">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center rounded-full text-ink hover:bg-accent-soft [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Menu className="size-5 group-open:hidden" aria-hidden="true" />
          <X className="hidden size-5 group-open:block" aria-hidden="true" />
        </summary>
        <ul
          class="absolute right-0 top-12 w-48 rounded-2xl border border-line bg-white p-2 shadow-[0_12px_32px_-12px_rgb(22_17_46/0.25)]"
        >
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class="block rounded-xl px-3 py-2.5 text-base text-ink hover:bg-accent-soft aria-[current=page]:font-medium"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
  </div>
</header>
