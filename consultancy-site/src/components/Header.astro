---
import { site } from '../config';
import Button from './Button.astro';
---

<header class="border-b border-line bg-paper/90 backdrop-blur sticky top-0 z-10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <a href="/" class="font-display text-xl font-bold tracking-tight" aria-label={site.name}>pop<span class="text-pink">.</span>consulting</a>
    <nav class="flex items-center gap-5 text-sm">
      <ul class="hidden sm:flex items-center gap-5 text-muted">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-ink transition-colors">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/book" size="sm">Book a call</Button>
    </nav>
  </div>
</header>
