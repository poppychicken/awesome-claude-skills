---
import { Menu, X } from 'lucide-react';
import { site, sectionHref } from '../config';
import Button from './Button.astro';
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-20 border-b border-line bg-paper">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <Logo />

    <nav aria-label="Main" class="flex items-center gap-2 text-sm md:gap-7">
      <ul class="hidden items-center gap-7 md:flex">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={sectionHref(item.id)}
                data-nav-link={item.id}
                class="relative py-2 text-muted transition-colors hover:text-ink aria-[current=true]:text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:rounded-full after:bg-teal after:transition-transform after:duration-300 aria-[current=true]:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href={sectionHref('contact')} size="sm">Book a call</Button>

      <!-- Phones and small tablets: a no-JS disclosure. -->
      <details class="group relative md:hidden" data-mobile-menu>
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center rounded-full text-ink hover:bg-accent-soft [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Menu className="size-5 group-open:hidden" aria-hidden="true" />
          <X className="hidden size-5 group-open:block" aria-hidden="true" />
        </summary>
        <ul
          class="absolute right-0 top-12 w-52 rounded-2xl border border-line bg-white p-2 shadow-[0_12px_32px_-12px_rgb(2_42_41/0.3)]"
        >
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={sectionHref(item.id)}
                  data-nav-link={item.id}
                  class="block rounded-xl px-3 py-2.5 text-base text-ink hover:bg-accent-soft aria-[current=true]:bg-accent-soft aria-[current=true]:font-medium"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  // Highlight the menu item for the section in view, and close the phone menu after a jump.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const sections = [...new Set(links.map((l) => l.dataset.navLink!))]
    .map((id) => document.getElementById(id))
    .filter((s): s is HTMLElement => s !== null);

  const setCurrent = (id: string | null) => {
    for (const link of links) {
      if (link.dataset.navLink === id) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
  };

  if (sections.length) {
    const visible = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) visible.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0);
        // The section crossing the band just under the header wins.
        const current = sections.find((s) => (visible.get(s.id) ?? 0) > 0);
        setCurrent(current?.id ?? null);
      },
      { rootMargin: '-35% 0px -60% 0px', threshold: [0, 0.01] },
    );
    sections.forEach((s) => observer.observe(s));
  }

  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) menu.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
