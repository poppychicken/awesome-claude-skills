---
const steps = [
  {
    title: 'Discover',
    body: 'Understand your business, your customers and your ambitions, and where change would genuinely move the needle.',
  },
  {
    title: 'Decide',
    body: 'Agree a focused plan: the few bets worth making, the business case, and what you will not do.',
  },
  {
    title: 'Deliver',
    body: 'Redesign the work and build, buy or integrate the right tools, alongside your team, until they are in daily use.',
  },
  {
    title: 'Embed',
    body: 'Put the skills, governance and measures in place so the change sticks and keeps compounding.',
  },
];
// The order is the method, so the step numbers carry information.
// Dots walk the hero blend from Marine to Reef, ending in white.
const stepDots = ['bg-marine', 'bg-teal', 'bg-reef', 'bg-white'];
---

<section id="approach" aria-labelledby="approach-title" class="scroll-mt-16 bg-abyss text-white">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
    <div class="max-w-2xl">
      <h2 id="approach-title" class="text-5xl font-bold sm:text-6xl">How we work</h2>
      <p class="mt-5 text-lg text-white/85">One team from first conversation to lasting change.</p>
    </div>
    <ol
      class="relative mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8 lg:before:absolute lg:before:inset-x-0 lg:before:top-[7px] lg:before:h-px lg:before:bg-white/25 lg:before:content-['']"
    >
      {
        steps.map((s, i) => (
          <li class="relative">
            <span aria-hidden="true" class:list={['block size-[15px] rounded-full ring-4 ring-abyss', stepDots[i]]} />
            <p class="mt-6 font-display text-sm font-semibold tabular-nums text-reef">Step {i + 1}</p>
            <h3 class="mt-1 text-2xl font-bold">{s.title}</h3>
            <p class="mt-3 max-w-[34ch] text-white/85">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
