---
import { FeatureSteps } from '@/components/ui/feature-section';

// Sample copy: the three areas of work. Edit freely; keep claims to what you can stand behind.
// Images: supplied abstract artwork, gradient-mapped to the hero blend (Abyss -> Reef), self-hosted in
// public/images/services (decorative, so alt is empty).
const services = [
  {
    step: 'Strategy',
    title: 'Strategy',
    content: 'Set a clear direction, then make the hard choices that get you there.',
    image: '/images/services/strategy.jpg',
    alt: '',
    points: [
      'Growth and corporate strategy',
      'Market, customer and competitor insight',
      'Operating model and organisation design',
      'Board- and investor-ready plans',
    ],
  },
  {
    step: 'AI',
    title: 'AI',
    content: 'Find where AI creates real value in your business, then put it to work safely.',
    image: '/images/services/ai.jpg',
    alt: '',
    points: [
      'AI opportunity assessment and business case',
      'Use-case prioritisation and roadmap',
      'Build, buy or integrate, through to launch',
      'Governance, risk and responsible-AI guardrails',
    ],
  },
  {
    step: 'Digital Transformation',
    title: 'Digital Transformation',
    content: 'Modernise how your business runs, with people, process and technology moving together.',
    image: '/images/services/digital-transformation.jpg',
    alt: '',
    points: [
      'Process redesign and automation',
      'Technology and data roadmap',
      'Programme leadership and delivery assurance',
      'Change management and capability building',
    ],
  },
];
---

<section id="services" aria-labelledby="services-title" class="scroll-mt-16">
  <FeatureSteps
    client:visible
    features={services}
    title="Services"
    titleId="services-title"
    description="Three areas of work, delivered by the same two people. Most clients start with one and bring us into the others as the work grows."
    autoPlayInterval={6000}
    imageHeight="lg:h-[460px]"
    imageFade={false}
    className="mx-auto max-w-6xl px-4 pt-24 pb-16 sm:px-6 sm:pt-32 md:px-6 md:pt-32 md:pb-24"
  />
</section>
