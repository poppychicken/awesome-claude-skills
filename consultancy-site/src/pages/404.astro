---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Page not found">
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-32 text-center">
    <h1 class="text-4xl font-semibold">Page not found</h1>
    <p class="mt-4 text-muted">That page doesn't exist.</p>
    <div class="mt-8"><Button href="/">Back to home</Button></div>
  </section>
</Base>
