---
import Base from '../layouts/Base.astro';
import { site } from '../config';

const expectations = [
  '30 minutes, video call',
  'You speak with both founders',
  'An honest view of where AI could help your business',
  'No obligation and no sales deck',
];
---

<Base title="Book a call" description="Book an introductory call about putting AI at the centre of your business.">
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-20 pb-20 grid gap-12 lg:grid-cols-[1fr_1.4fr]">
    <div>
      <h1 class="text-4xl sm:text-5xl font-semibold">Book a call</h1>
      <p class="mt-4 text-lg text-muted">Pick a time that suits you.</p>
      <ul class="mt-8 space-y-3">
        {
          expectations.map((e) => (
            <li class="flex gap-2">
              <span class="text-accent" aria-hidden="true">
                ✓
              </span>
              {e}
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-sm text-muted">
        Prefer email? <a class="underline hover:text-ink" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    <div class="rounded-2xl border border-line bg-white overflow-hidden min-h-[640px]">
      {
        site.bookingUrl ? (
          <iframe
            src={site.bookingUrl}
            title="Book a call"
            class="w-full h-[700px] border-0"
            loading="lazy"
          />
        ) : (
          <div class="h-full min-h-[640px] flex items-center justify-center p-8 text-center text-muted">
            <p>
              Booking calendar goes here.
              <br />
              Set <code class="text-ink">bookingUrl</code> in <code class="text-ink">src/config.ts</code> to your
              Cal.com or Calendly link.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Base>
