---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import CallToAction from '../components/CallToAction.astro';

// Placeholder copy — replace once positioning is agreed.
const problems = [
  {
    title: 'Pilots that never ship',
    body: 'Promising AI experiments stall before they reach recruiters, managers or employees.',
  },
  {
    title: 'Risk and trust concerns',
    body: 'Bias, data privacy and employment regulation make people decisions a high-stakes place for AI.',
  },
  {
    title: 'No clear return',
    body: 'Tools get bought, but nobody can say what changed for time-to-hire, retention or cost.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Assess',
    body: 'Map your people processes, data and systems to find where AI will genuinely help — and where it should not be used.',
  },
  {
    n: '02',
    title: 'Design',
    body: 'Choose use cases, tools and guardrails, with governance and change management built in from day one.',
  },
  {
    n: '03',
    title: 'Deploy',
    body: 'Implement alongside your team, train the people who will use it, and get it into daily work.',
  },
  {
    n: '04',
    title: 'Measure',
    body: 'Track the outcomes you agreed at the start and refine until the numbers move.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
    <p class="text-sm font-medium text-accent uppercase tracking-wider">AI deployment for human capital</p>
    <h1 class="mt-4 text-4xl sm:text-6xl font-semibold max-w-3xl leading-tight">
      Put AI to work in your people function — responsibly, and for real.
    </h1>
    <p class="mt-6 text-lg text-muted max-w-2xl">
      We help HR, talent and workforce teams move from AI curiosity to deployed tools that save time, improve
      decisions and earn employee trust.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/book">Book a call</Button>
      <Button href="/services" variant="secondary">See how we help</Button>
    </div>
  </section>

  <!-- Problems -->
  <section class="border-y border-line bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-20">
      <h2 class="text-3xl font-semibold max-w-xl">Most AI efforts in HR stall for the same reasons</h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-3">
        {
          problems.map((p) => (
            <div>
              <h3 class="text-xl font-semibold">{p.title}</h3>
              <p class="mt-2 text-muted">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-24 scroll-mt-20">
    <h2 class="text-3xl font-semibold max-w-xl">How we work</h2>
    <p class="mt-3 text-muted max-w-2xl">A practical path from first conversation to measurable change.</p>
    <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s) => (
          <li class="rounded-2xl border border-line bg-white p-6">
            <span class="text-sm font-medium text-accent">{s.n}</span>
            <h3 class="mt-2 text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 text-muted text-sm">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <CallToAction />
</Base>
