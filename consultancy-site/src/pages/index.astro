---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import CallToAction from '../components/CallToAction.astro';

// Placeholder copy: refine once positioning settles.
const reasons = [
  {
    title: 'Executive judgement',
    body: 'We have sat in the leadership seat. We think in terms of P&L, risk and people, not just models and tools.',
  },
  {
    title: 'Strategy and delivery, together',
    body: 'The people who shape the plan are the people who build it. No handoffs, and no strategy decks left on a shelf.',
  },
  {
    title: 'Small by design',
    body: 'You work directly with the two founders, every time. No junior teams learning on your budget.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Discover',
    body: 'Understand your business, your data and your ambitions, and where AI could genuinely move the needle.',
  },
  {
    n: '02',
    title: 'Decide',
    body: 'Set a focused AI strategy: the few bets worth making, the business case, and what you will not do.',
  },
  {
    n: '03',
    title: 'Deliver',
    body: 'Build, buy or integrate the right tools, working alongside your team to get them into daily use.',
  },
  {
    n: '04',
    title: 'Embed',
    body: 'Put the skills, governance and measures in place so the change sticks and keeps compounding.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="bg-brand-gradient text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-20 pb-20 sm:pt-28 sm:pb-28">
      <p class="text-sm font-medium text-white/70 uppercase tracking-wider">
        Strategy &amp; implementation, with AI at the centre
      </p>
      <h1 class="mt-4 text-4xl sm:text-6xl font-semibold max-w-3xl leading-tight">
        From AI ambition to results your business can see.
      </h1>
      <p class="mt-6 text-lg text-white/80 max-w-2xl">
        We are a small, senior team of former executives. We help leadership teams decide where AI should change
        how they work, then stay to make it happen.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="/book" variant="inverse">Book a call</Button>
        <Button href="/services" variant="outline-light">What we do</Button>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="border-b border-line bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-20">
      <h2 class="text-3xl font-semibold max-w-xl">Why leadership teams work with us</h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-3">
        {
          reasons.map((r) => (
            <div class="border-t-2 border-accent pt-5">
              <h3 class="text-xl font-semibold">{r.title}</h3>
              <p class="mt-2 text-muted">{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-24 scroll-mt-20">
    <h2 class="text-3xl font-semibold max-w-xl">How we work</h2>
    <p class="mt-3 text-muted max-w-2xl">One team from first conversation to lasting change.</p>
    <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s) => (
          <li class="rounded-2xl border border-line bg-white p-6">
            <span class="text-sm font-medium text-accent">{s.n}</span>
            <h3 class="mt-2 text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 text-muted text-sm">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <CallToAction />
</Base>
