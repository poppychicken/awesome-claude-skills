---
import Base from '../layouts/Base.astro';
import CallToAction from '../components/CallToAction.astro';
import PopHero from '@/components/PopHero';

const steps = [
  {
    title: 'Discover',
    body: 'Understand your business, your data and your ambitions, and where AI could genuinely move the needle.',
  },
  {
    title: 'Decide',
    body: 'Set a focused AI strategy: the few bets worth making, the business case, and what you will not do.',
  },
  {
    title: 'Deliver',
    body: 'Build, buy or integrate the right tools, working alongside your team to get them into daily use.',
  },
  {
    title: 'Embed',
    body: 'Put the skills, governance and measures in place so the change sticks and keeps compounding.',
  },
];
// The order is the method, so the step numbers carry information.
const stepDots = ['bg-violet', 'bg-pink', 'bg-tangerine', 'bg-violet-deep'];
---

<Base>
  <PopHero client:load />

  <!-- Approach -->
  <section id="approach" class="mx-auto max-w-6xl scroll-mt-20 px-4 pt-20 pb-8 sm:px-6 sm:pt-28">
    <div class="max-w-2xl">
      <h2 class="text-4xl font-bold sm:text-5xl">How we work</h2>
      <p class="mt-4 text-lg text-muted">One team from first conversation to lasting change.</p>
    </div>
    <ol
      class="relative mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8 lg:before:absolute lg:before:inset-x-0 lg:before:top-[7px] lg:before:h-px lg:before:bg-line lg:before:content-['']"
    >
      {
        steps.map((s, i) => (
          <li class="relative">
            <span aria-hidden="true" class:list={['block size-[15px] rounded-full ring-4 ring-paper', stepDots[i]]} />
            <p class="mt-6 font-display text-sm font-semibold text-muted tabular-nums">Step {i + 1}</p>
            <h3 class="mt-1 text-2xl font-bold">{s.title}</h3>
            <p class="mt-3 max-w-[34ch] text-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <CallToAction />
</Base>
