---
import Base from '../layouts/Base.astro';
import { Check } from 'lucide-react';
import CallToAction from '../components/CallToAction.astro';

// Placeholder services: rename or remove to match your offer.
const services = [
  {
    title: 'AI Strategy',
    summary: 'Decide where AI creates real value for your business, and where it does not.',
    outcomes: [
      'Opportunity map across your operations',
      'Prioritised roadmap and business case',
      'Board-ready recommendations',
    ],
  },
  {
    title: 'Implementation',
    summary: 'Get the priorities live, working alongside your team rather than handing over a plan.',
    outcomes: [
      'Build, buy or integrate decisions',
      'Hands-on delivery and launch',
      'Adoption and training for the people using it',
    ],
  },
  {
    title: 'Leadership & Capability',
    summary: 'Give your organisation the skills, structures and oversight to keep going without us.',
    outcomes: [
      'Governance and responsible-AI guardrails',
      'Team capability and operating model',
      'Fractional AI leadership for your exec team',
    ],
  },
];
---

<Base title="Services" description="AI strategy, implementation and leadership capability from a small, senior team.">
  <section class="mx-auto max-w-6xl px-4 pt-20 pb-6 sm:px-6 sm:pt-28">
    <h1 class="text-5xl font-bold sm:text-6xl">Services</h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">
      Strategy and implementation from the same two people. Start with a focused strategy piece, or bring us in
      end to end.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6">
    {
      services.map((s) => (
        <article class="grid gap-6 border-t border-line py-10 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-12 md:py-14">
          <div>
            <h2 class="text-3xl font-bold">{s.title}</h2>
            <p class="mt-3 max-w-[40ch] text-lg text-muted">{s.summary}</p>
          </div>
          <ul class="grid content-start gap-3 sm:grid-cols-1">
            {s.outcomes.map((o) => (
              <li class="flex items-start gap-3">
                <Check aria-hidden="true" className="mt-0.5 size-5 shrink-0 text-violet" strokeWidth={2.25} />
                <span>{o}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <CallToAction heading="Not sure where to start?" body="Most clients begin with a short call. We will suggest the smallest useful next step." />
</Base>
